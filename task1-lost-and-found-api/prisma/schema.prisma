generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  RECOVERED
  NOT_RECOVERED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  reports   Report[]
}

model Report {
  id          Int          @id @default(autoincrement())
  itemName    String
  imageUrl    String?
  type        ReportType
  status      ReportStatus @default(NOT_RECOVERED)
  description String?
  place       String
  date        DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([date])
  @@index([userId])
}
